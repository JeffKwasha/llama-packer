# llama-swap.service -- hardened unit template for llama-packer's install.py.
#
# Substituted by `extras/install.py`; @PLACEHOLDER@ tokens are replaced:
#   @USER@ @GROUP@ @DIR@ @SWAP@ @LISTEN@
#
# @SWAP@ is the llama-swap binary this deployment actually has. It is
# @DIR@/tools/llama-swap for anything installed by the current install.py,
# and @DIR@/llama-swap for a deployment whose binaries predate that layout —
# resolved rather than assumed, because a unit naming a file that is not
# there fails in the least legible way available. WorkingDirectory stays the
# run directory either way: it is where config.yaml lives, and audio.cpp
# entries write their per-port server.json under /tmp/llama-swap from there.
#
# The hardening block is the point of this file and is copied verbatim into
# the installed unit -- do not weaken it to make an install succeed. Two
# properties depend on choices install.py makes, not on this file:
#
#   * The service user is created --system --no-create-home. Everything
#     below assumes it has no home to reach: ProtectHome plus
#     InaccessiblePaths hide /home and /var/lib outright, so a user whose
#     home lives there would find it invisible.
#   * DeviceAllow lines name the GPU nodes that actually exist on this
#     host. A pinned /dev/dri/renderD128 is wrong after a card reorder.
#   * @GPU_ENV@ carries the vendor's device-selection variables, chosen by
#     what /dev/kfd or /dev/nvidia* says is present.
#
# Note the unit runs read-only: the service never writes to @DIR@. The
# directory is group-writable so a member of @GROUP@ can re-run
# llama-packer and have -watch-config pick the new config up in place.
#
# Validated on every change: `systemd-analyze verify` and
# `llama-swap -config <dir>/config.yaml -validate`.

[Unit]
Description=llama-swap
After=network.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5
User=@USER@
Group=@GROUP@
WorkingDirectory=@DIR@
ExecStart=@SWAP@ --listen @LISTEN@ --config @DIR@/config.yaml -watch-config
Environment=PATH=/usr/local/bin:/usr/bin:/bin
@GPU_ENV@
EnvironmentFile=-@DIR@/config.env

# --- Memory limits
# Trailing comments are NOT allowed here: systemd reads the whole rest of
# the line as the value, so `MemoryHigh=32G  # cap` is an invalid limit and
# the directive is dropped without an error. Keep the prose on its own line.
#   MemoryHigh    soft cap: kernel reclaims aggressively above this
#   MemoryMax     hard cap: cgroup OOM killer fires, kills llama-server
#   MemorySwapMax limit the swap escape hatch (prevents swap thrash)
MemoryHigh=@MEM_HIGH@
MemoryMax=@MEM_MAX@
MemorySwapMax=@SWAP_MAX@

# --- Filesystem: everything read-only except what's needed ---
ProtectSystem=strict
ProtectHome=true
# PrivateTmp already mounts a private, writable /tmp and /var/tmp inside the
# namespace, so no ReadWritePaths grant is needed for either.
PrivateTmp=true
# Only directories that exist on this host may be listed: systemd treats a
# path in InaccessiblePaths= that is missing as a fatal namespace error
# (226/NAMESPACE) and the unit never starts. /efi is exactly that on a box
# without a separate ESP, which is how this brought the service down.
# install.py substitutes the present subset.
InaccessiblePaths=@INACCESSIBLE_PATHS@

# --- Devices: block all, allow only the GPU nodes this host actually has ---
# DevicePolicy=closed + DeviceAllow, not PrivateDevices=true. Verified on
# systemd 259 (2026-10-19): the private /dev never materialises the
# DeviceAllow'd DRI/kfd nodes (open → ENOENT), so with PrivateDevices every
# Vulkan backend is skipped and llama-server serves on CPU, silently. closed
# keeps the cgroup-v2 BPF device blocklist on the shared /dev; note the
# explicit node paths are required — the `char-dri` alias does not enumerate
# under a closed policy even when the paths do.
DevicePolicy=closed
@DEVICE_ALLOW@

# --- Privilege & kernel lockdown ---
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true

# --- Namespace & syscall restrictions ---
RestrictNamespaces=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictFileSystems=

# --- Misc ---
# ProtectProc=invisible hides *other users'* processes, which is the part that
# matters here. ProcSubset=pid is deliberately NOT set, despite being the
# natural companion: it hides the non-process entries under /proc, and the
# serving stack reads several of them.
#
#   * llama-swap logs `failed to read sys stats: couldn't read /proc/meminfo`
#     on every matrix decision without it, and the matrix planner needs total
#     memory to decide whether a set fits at all.
#   * The GPU backends probe system memory during device init. With
#     /proc/meminfo unreadable, ggml's Vulkan/HIP init cannot size its buffers,
#     the device is skipped, and llama.cpp falls back to CPU *silently* —
#     `--n-gpu-layers` set and all — while /proc/meminfo is exactly what the
#     GPU stack needs to see a card.
#
# Both failures are quiet in the sense that the service stays up and serves;
# they show up as CPU-shaped throughput and a log line nobody reads.
ProtectProc=invisible
MemoryDenyWriteExecute=false
OOMScoreAdjust=1000

[Install]
# Without this the unit is "static": `systemctl enable` fails outright and
# the service does not come back after a reboot.
WantedBy=multi-user.target
