#!/usr/bin/env bash
set -euo pipefail

# llama.cpp update script for Linux
# Usage: ./update [version]
# Examples:
#   ./update             # Get latest release
#   ./update b8913       # Get specific version
#   ./update vulkan      # Get latest Vulkan build
#   ./update rocm        # Get latest ROCm build

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
RELEASES_URL="https://api.github.com/repos/ggml-org/llama.cpp/releases"
KEEP_VERSIONS=3  # Keep current + N-1 previous versions
NEWLY_INSTALLED=false

# Get highest installed version number
get_highest_installed() {
    local highest=0
    for d in "$SCRIPT_DIR"/llama-b[0-9]*; do
        [ -d "$d" ] || continue
        ver="${d##*b}"
        [ "$ver" -gt "$highest" ] 2>/dev/null && highest="$ver"
    done
    echo "$highest"
}

# Compare versions: returns 0 if new_ver > old_ver
is_newer() {
    local new_ver="$1"
    local old_ver="$2"
    [ "$new_ver" -gt "$old_ver" ] 2>/dev/null
}

usage() {
    cat <<EOF
Usage: $(basename "$0") [version|vulkan|rocm]

Download and install llama.cpp prebuilt binaries.

Arguments:
  version       Specific version tag (e.g., b8913, b8902)
  vulkan Latest Vulkan build (default)
  rocm   Latest ROCm build

Examples:
  $(basename "$0")              # Latest Vulkan
  $(basename "$0") b8913        # Specific version
  $(basename "$0") rocm  	# Latest ROCm

EOF
    exit 1
}

# Get latest release tag
get_latest_tag() {
    curl -s "$RELEASES_URL" | grep -o '"tag_name": ".*"' | head -1 | cut -d'"' -f4
}

# Get release assets for a tag
get_assets() {
    local tag="$1"
    curl -s "https://api.github.com/repos/ggml-org/llama.cpp/releases/tags/$tag"
}

# Find asset URL by pattern
find_asset() {
    local assets="$1"
    local pattern="$2"
    echo "$assets" | grep -o "\"browser_download_url\": \"[^\"]*${pattern}[^\"]*\"" | head -1 | cut -d'"' -f4
}

download_and_extract() {
    local url="$1"
    local version="$2"
    local target_dir="${SCRIPT_DIR}/llama-${version}"

    # Check if already installed
    if [ -d "$target_dir" ]; then
        echo "llama.cpp $version already installed at $target_dir"
        return 1
    fi

    echo "Downloading llama.cpp $version..."
    local archive=$(basename "$url")
    curl -L -o "$archive" "$url"

    echo "Extracting..."
    tar -xzf "$archive"

    # Move contents to versioned directory
    #local extracted_dir="${archive%.tar.gz}"
    #mv "$extracted_dir" "$target_dir"

    # Cleanup
    rm -f "$archive"

    echo "Installed to: $target_dir"
    echo "Run: $target_dir/llama-server --help"
}

# Remove old versions, keeping only the newest KEEP_VERSIONS
cleanup_old_versions() {
    # Safety: SCRIPT_DIR must be owned by current user
    [[ "$(stat -c '%u' "$SCRIPT_DIR")" != "$(id -u)" ]] && return 0

    # Only match directories with 4+ digit version numbers (e.g. llama-b8913)
    local dirs=()
    for d in "$SCRIPT_DIR"/llama-b[0-9][0-9][0-9][0-9]*; do
        [ -d "$d" ] && dirs+=("$d")
    done

    # Nothing to clean
    [ "${#dirs[@]}" -le "$KEEP_VERSIONS" ] && return 0

    # Sort by version number descending
    local sorted
    sorted=$(printf '%s\n' "${dirs[@]}" | sort -t'b' -k2 -n -r)

    local keep=$KEEP_VERSIONS
    while IFS= read -r dir; do
        keep=$((keep - 1))
        [ "$keep" -lt 0 ] && echo "Removing old version: $dir" && rm -rf "$dir"
    done <<< "$sorted"
}

# Main
VERSION="${1:-latest-vulkan}"

HIGHEST_INSTALLED=$(get_highest_installed)

case "$VERSION" in
    *vulkan)
        TAG=$(get_latest_tag)
        if is_newer "$HIGHEST_INSTALLED" "${TAG#b}"; then
            echo "Already have version b$HIGHEST_INSTALLED, which is newer than $TAG"
            exit 0
        fi
        ASSETS=$(get_assets "$TAG")
        URL=$(find_asset "$ASSETS" "ubuntu-vulkan-x64")
        if [ -z "$URL" ]; then
            echo "Error: Could not find Vulkan asset for $TAG" >&2
            exit 1
        fi
        if download_and_extract "$URL" "$TAG"; then
            NEWLY_INSTALLED=true
        fi
        ;;
    *rocm)
        TAG=$(get_latest_tag)
        if is_newer "$HIGHEST_INSTALLED" "${TAG#b}"; then
            echo "Already have version b$HIGHEST_INSTALLED, which is newer than $TAG"
            exit 0
        fi
        ASSETS=$(get_assets "$TAG")
        URL=$(find_asset "$ASSETS" "ubuntu-rocm-[^-]*-x64")
        if [ -z "$URL" ]; then
            echo "Error: Could not find ROCm asset for $TAG" >&2
            exit 1
        fi
        if download_and_extract "$URL" "$TAG"; then
            NEWLY_INSTALLED=true
        fi
        ;;
    latest)
        TAG=$(get_latest_tag)
        if is_newer "$HIGHEST_INSTALLED" "${TAG#b}"; then
            echo "Already have version b$HIGHEST_INSTALLED, which is newer than $TAG"
            exit 0
        fi
        ASSETS=$(get_assets "$TAG")
        URL=$(find_asset "$ASSETS" "ubuntu-vulkan-x64")
        if [ -z "$URL" ]; then
            echo "Error: Could not find Vulkan asset for $TAG" >&2
            exit 1
        fi
        if download_and_extract "$URL" "$TAG"; then
            NEWLY_INSTALLED=true
        fi
        ;;
    *)
        # Treat as specific version tag
        ASSETS=$(get_assets "$VERSION")
        if [ -z "$ASSETS" ] || [ "$ASSETS" = "[]" ]; then
            echo "Error: Version $VERSION not found" >&2
            exit 1
        fi
        URL=$(find_asset "$ASSETS" "ubuntu-vulkan-x64")
        if [ -z "$URL" ]; then
            # Try ROCm
            URL=$(find_asset "$ASSETS" "ubuntu-rocm-[^-]*-x64")
            if [ -z "$URL" ]; then
                echo "Error: Could not find Linux asset for $VERSION" >&2
                exit 1
            fi
        fi
        if download_and_extract "$URL" "$VERSION"; then
            NEWLY_INSTALLED=true
        fi
        ;;
esac

# Cleanup old versions after successful install
if [ "$NEWLY_INSTALLED" = true ]; then
    cleanup_old_versions
fi
