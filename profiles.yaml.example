# ── Sidecar syntax ─────────────────────────────────────
# Compatibility and capability are declared, never inferred. In a model
# sidecar (the `<model>.md` beside the weights):
#   engines: [llama-server]    # engine names that can load the weights;
#                              # required — a single-engine claim is a list
#   role: chat                 # operator-defined purpose (see roles: below)
#   tasks: [embeddings]        # declared task ids; unset/empty = unverified
# `backend:` (compatibility) and `usage:` (workload tags) are the old
# spellings: they warn as alien keys, and there is no tolerated dual
# vocabulary.
#
# ── Global defaults ────────────────────────────────────
defaults:
  cache_type: q8_0
  # Do not set `parallel` here unless you intend to pin every model and
  # disable auto-parallel; leaving it unset lets the packer choose the
  # context size and slot count.
  #
  # Headroom for the desktop, browser, or other tenants. This comes on top
  # of the fixed reserve: reserve = 1024 + max(1024, baseline_mb), and
  # pools.default = VRAM - reserve - spare. Pick it from vram_log --report
  # over days; --once is a snapshot that includes loaded models. Allocations
  # fill the pool on purpose, so reserve + spare is the whole headroom.
  spare: 1G
  temperature: 1.0
  top_p: 0.95
  top_k: 20
  min_p: 0.01
  pres_pen: 0.0

# ── Tasks (optional) ──────────────────────────────────
# A task is a named kind of work (coding, chat, embeddings...) with the
# endpoint it is served at and the least context and slots it needs. A
# model claims tasks in its sidecar with `tasks: [coding, chat]`; each task
# a model can satisfy gets its own entry, and llama-swap routes by name. An
# unknown name warns and is ignored.
#
# This section sets a task's minimums; it cannot invent a task.
# min_context and min_parallel are both minimums. Leave a key out for no
# minimum; one entry at context >= 128k and slots >= 2 can satisfy several
# tasks, so nothing forces four entries per model.
#
# require:   capabilities that must survive. A model that cannot keep one is
#            not offered for that task rather than being degraded.
# sacrifice: what to give up first when memory is short. This is a
#            *preference*, not a cost order — giving something up may buy no
#            context at all (a model already at its design cap has nothing
#            to reclaim). Unlisted capabilities go vision before draft,
#            because an MTP draft roughly doubles generation speed. Shedding
#            a draft is opt-in per model (`allow_mtp_shed:`).
#
# Only chat-task models are considered here.
#
# shed: the default order for capabilities a task does not name.
# shed: [vision, draft]
tasks:
  # A task is an endpoint contract plus demand. It does not name a role:
  # the model's role is the model's. `device` is `auto`, `cpu`, or a GPU
  # index; a sidecar `device:` wins. `parallel_power` overrides
  # matrix.parallel_power for that task: low keeps context, high buys slots.
  # `max_context` is the served ceiling; for embeddings/rerank it is the RAG
  # window.
  #
  # A model's tasks must share one endpoint: `--embeddings` and chat are
  # different commands, so they cannot be one serving. Chat tasks are
  # aliases of one serving; each gets its own entry.
  chat:
    endpoint: openai.chat.completions
    min_context: 64k
    min_parallel: 2
    sacrifice: [draft, vision]
  coding:
    endpoint: openai.chat.completions
    min_context: 130k
    min_parallel: 1
    sacrifice: [vision]
    keep: [draft]
  qa:
    endpoint: openai.chat.completions
    min_context: 32k
    min_parallel: 2
  aux:
    endpoint: openai.chat.completions
    min_context: 80k
    min_parallel: 2
    sacrifice: [draft]
  embeddings:
    endpoint: openai.embeddings
    max_context: 4096      # the served RAG window; clients chunk to fit
    ttl: 0                 # keep the RAG pair warm
  rerank:
    endpoint: openai.rerank
    max_context: 4096
    ttl: 0
  image:
    endpoint: openai.images.generations
  s2t:
    endpoint: openai.audio.transcriptions
    device: cpu
    # CPU default is 3600 s; set ttl: 0 to keep it warm.
  t2s:
    endpoint: openai.audio.speech

# ── Roles (required) ───────────────────────────────────
# A role is an operator-defined purpose and allocation policy. The code ships
# no role names; these are data. A role owns one or more trees with `dir:`;
# every model under them belongs to it. A sidecar `role:` overrides the tree.
# There is no default role: a model under no role's tree and with no `role:`
# is an error, as is a `role:` naming a role not defined here.
#
# Every serving's floor (weights + the memory its task's min_context and
# min_parallel need) is taken out first. `share` divides only what is left:
#   share    percentage of slack this role may claim
#   fill     take whatever no other share claims (one role per pool)
#   live     1 (one serving, evicts) | per-device | capacity
#   device   cpu | GPU index — where every model of the role runs. Same
#            vocabulary as a sidecar `device:`; omit it to leave placement
#            to the sidecar (and the task). `cpu` means no VRAM charge,
#            -ngl 0, and a charge against the `ram` pool.
# Shares in a pool must sum to at most 100%; the rest is headroom. A role with
# `share: 100%` runs alone. There is no min/preferred/cap/weight: floors are
# derived, a share is already a cap, and one fill role takes the rest.
# There is no `persistent:` — residency is a TTL, set with `ttl: 0` on the
# task (or the sidecar), not a role flag.
roles:
  chat:
    dir: [chat, t2t, vision, doc, ocr]
    kind: chat
    fill: true
    live: 1
  embeddings:
    dir: embed
    kind: embeddings
    share: 5%
    live: 1
    # device: cpu          # run the whole role from system RAM
  rerank:
    dir: rerank
    kind: rerank
    share: 5%
    live: 1
  image:
    dir: img
    kind: image
    share: 20%
    live: 1
  s2t:
    dir: s2t
    kind: s2t
    share: 5%
    live: per-device
  t2s:
    dir: t2s
    kind: t2s
    share: 5%
    live: per-device

# ── Routing ────────────────────────────────────────────
# There is no `routing.use`. The mode follows from the input: `matrix.sets:`
# present → matrix; absent → capacity. `group` is not emitted; `exclusive` is
# `share: 100%`; residency is `ttl: 0`.
#
# capacity  one global budget: every combination that fits may be resident,
#           so shares must sum to 100%.
# matrix    each set is its own budget, so roles may exceed their global
#           share when no set holds them together. Only a set can forbid a
#           combination that fits. It never preloads.

# Model roots (CLI --models-dir overrides this). A model belongs to the role
# whose `dir:` owns its directory (case-insensitive, relative to the root);
# a subtree no role owns is skipped and named in the run log.  Any
# subdirectory may also carry a models.yaml with subtree-scoped `defaults:`
# and `overrides:`.
models_dirs:
  - models
  # - /mnt/ai/models  # multiple roots allowed

# HF cache root for hub-snapshot resolution (hf_repo + model sidecars) and
# the ${HF_HOME} path macro.  Defaults to $HF_HOME / $HUGGINGFACE_HUB_CACHE /
# ~/.cache/huggingface.
# hf_home: /mnt/data/huggingface

# Backend enable/prefer list — ordered; a backend absent from the list is
# disabled even when its resources are configured.  Omit the key to use all
# registered backends in default order (llama-server, vllm, vllm-podman,
# vllm-docker, sd-server, whisper-server, audio-cpp).  sd-server is opt-in
# for image generation, whisper-server/audio-cpp for speech; see the sd:/
# whisper:/audio_cpp: sections below.
# backends:
#   - llama-server
#   - vllm-docker
#   - sd-server
#   - whisper-server

# ── Profile definitions ────────────────────────────────
# Each profile overlays `defaults` and becomes llama-swap's per-request
# sampling overrides. `allow_profiles` in a model sidecar can filter which profiles
# apply to that model. Sidecar `modes:` layer over the same-named profile
# (single merge rule: dicts merge, lists append, None deletes) and replace
# the profile sampling overrides per-model when present.
profiles:
  default:

  coder:
    description: "coding and agentic work"
    temperature: "base * 0.7"

  # creative:
  #   description: "creative writing"
  #   temperature: "base * 1.2"

  # ── Sampling params ──────────────────────────────────
  # Keys: temperature, top_p, top_k, min_p, pres_pen, repeat_penalty,
  # freq_pen. Any key also present in `defaults` may use a "base * N"
  # expression (e.g. "base * 0.6"); otherwise set a literal. Values differing
  # from defaults are emitted as setParamsByID (request keys: pres_pen →
  # presence_penalty, freq_pen → frequency_penalty).
  # precise:
  #   description: "Low variance for extraction / QA"
  #   temperature: "base * 0.3"
  #   top_p: 0.9
  #   top_k: 10
  #   repeat_penalty: 1.1

  # story:
  #   description: "More diverse sampling for storytelling"
  #   temperature: "base * 1.3"
  #   min_p: 0.02
  #   pres_pen: 0.4
  #   freq_pen: 0.2

  # ── Grouping / placement params ──────────────────────
  # Distinct (parallel, cache_type, spare, batch, ubatch) combos get their
  # own memory allocation and llama-swap entry; profile names within a group
  # become per-request overrides. `spare` reserves VRAM headroom.
  # `parallel` is the slot count — and a pin: declaring it opts the model
  # out of auto-parallel.
  # server:
  #   description: "Concurrency-tuned"
  #   parallel: 2
  #   cache_type: q4_K_M
  #   spare: 2G

  # low-mem:
  #   description: "Smaller KV cache for tight VRAM budgets"
  #   cache_type: q4_0
  #   spare: 1G

# ── llama-server backend args (optional) ────────────────
# Free-form flags appended to every llama-server command — fleet-wide
# performance/tuning knobs (per-model sidecar `cli_args:` still wins per
# flag).  Rendered BEFORE the named batch/ubatch flags, so those win over
# conflicting values here: `-b 512` in args tunes nothing once named keys
# are set (a warning points at the keys).  Non-conflicting flags (e.g.
# --flash-attn) apply to all roles and ARE part of the VRAM measurement
# shape — changing them re-measures every persisted `derived:` block.
#
# batch/ubatch are first-class planning keys with a resolution cascade:
#   sidecar batch:/ubatch:  >  profile key  >  llama_server: here  >  backend
#   role defaults
# Leaving a key unset anywhere in that cascade means **no flag is rendered**
# and llama.cpp's own builtin applies (-b 2048, -ub 512) — so an upstream
# default change is picked up for free instead of being pinned here. No
# llama-server role declares a batch default today: the old embed/rerank
# 4096 was never in effect (llama-server forces n_batch = n_ubatch when
# embeddings are enabled), so it was removed rather than copied. A malformed
# value is warned about and falls through to the next tier.
# `ubatch` shapes the compute buffer (~6 MiB per -ub token on Vulkan, no
# throughput cost measured) and stamps the VRAM measurement shape; `batch`
# has no VRAM effect and is deliberately not part of the shape.
# llama_server:
#   args: "--flash-attn on"
#   # batch: 2048       # -b, logical batch — throughput only, no VRAM effect
#   # ubatch: 512       # -ub, per-pass tokens — shapes the compute buffer

# ── vLLM backend (optional) ────────────────────────────
# Defaults for `backend: vllm` / `vllm-podman` / `vllm-docker` via overrides.
# CLI --vllm-image / --vllm-server win over this.
# vllm:
#   image: vllm/vllm-openai:latest
#   bin: vllm
#   docker_args: "--runtime=nvidia --gpus all --shm-size=16g"
#   container_port: 8000
#   # gpu_mem_util: 0.9  # derived from spare/reserve when omitted
#   # Fleet-wide serve flags (vLLM spellings — e.g. -ub 512 ≈
#   # --max-num-batched-tokens 512); per-model cli_args wins per flag.
#   # args: "--max-num-batched-tokens 512"

# ── sd-server backend (optional, image generation) ───────
# Defaults for `backend: sd-server` (stable-diffusion.cpp).  CLI --sd-server
# wins over this, then $SD_BIN_DIR, then the run directory (cwd),
# then `sd-server` on PATH.
# Unlike chat models, image models are fixed VRAM (weights + 512 MiB
# overhead) and excluded from the shared chat matrix — a 40 GB flux model won't
# collapse the chat budget.
# sd:
#   bin: sd-server
#   # Fleet-wide sd-server flags (--diffusion-fa etc.); per-model cli_args wins.
#   # args: "--diffusion-fa"

# ── whisper-server backend (optional, speech-to-text) ─────
# Defaults for `backend: whisper-server` (whisper.cpp examples/server).
# CLI --whisper-server wins over this, then $WHISPER_BIN_DIR, then the
# run directory (cwd), then `whisper-server` on PATH.  Opt-in: add `s2t: s2t` under `dirs:` above;
# each model needs an authored same-stem sidecar next to its GGML .bin
# (e.g. ggml-large-v3.md beside ggml-large-v3.bin).  Fixed VRAM overhead,
# excluded from the shared chat matrix.
# whisper:
#   bin: whisper-server
#   # Fleet-wide whisper-server flags (whisper.cpp shares --flash-attn);
#   # per-model cli_args wins.
#   # args: "--flash-attn on"

# ── audio-cpp backend (optional, TTS + ASR + music) ───────
# Defaults for `backend: audio-cpp` (native ggml audiocpp_server, 0xShug0).
# CLI --audio-cpp-server/--audio-cpp-backend win over this, then
# $AUDIOCPP_BIN_DIR, then the run directory (cwd), then
# `audiocpp_server` on PATH.  Opt-in: add
# `t2s: t2s` and/or `s2t: s2t` under `dirs:` above.  Fixed VRAM overhead
# (file size + family buffer), excluded from the shared chat matrix.
# One entry per sidecar (1:1) — switching models reloads audio.cpp.
# audio_cpp:
#   bin: /mnt/pool/data/tools/audiocpp/audiocpp_server
#   # Backend layering: sidecar audio_cpp.backend > --audio-cpp-backend >
#   # this value > vendor auto (NVIDIA→cuda, AMD→vulkan, else cpu).
#   backend: vulkan
#   device: 0
#   threads: 4
#   # Optional: per-entry TMPDIR env (shields /tmp/audiocpp-gguf extraction
#   # cache from other-uid ownership wedges on shared boxes).
#   # tmpdir: /tmp/audiocpp-llama-swap
#   # Stamped into every emitted server.json (see docs/backends/audio-cpp.md):
#   # max_loaded_models: 1
#   # idle_unload_ms: 60000
#   # busy_timeout_ms: 300000
#   # min_free_memory_mb: 2048
#   # voice_dir: /mnt/pool/data/tools/audiocpp/voices   # absolutized on emit
#   # model_spec_override: /mnt/pool/data/tools/audiocpp/model_specs

# ── Hardware (optional) ─────────────────────────────────
# Override the auto-detected VRAM pool and host-RAM budget. CLI --vram /
# --baseline / --unified-system-mb win over the VRAM side.
# Use `defaults.spare` for ordinary tenant/desktop headroom. `baseline_mb`
# is an advanced override for a known fixed pre-existing load; it only
# matters above the fixed 1 GiB video reserve and subtracts from the same
# pool.
# hardware:
#   vram: 48G
#   # baseline_mb: 512m        # known pre-existing load, above the 1 GiB floor
#   # unified_system_mb: 8192  # system slice on unified hosts (default 8192)
#   # memory_margin: 0.04      # fraction inflated against every measured VRAM
#   #                          # term when solving (default 0.04: covers the
#   #                          # allocator overhead llama.cpp's own buffers
#   #                          # don't report, ~4% observed on Vulkan/radv)
#   # fast_storage: /mnt/@/ssd_ai   # physical branch (or list) that holds
#   #                          # SSD-resident models — reads ~6x faster than
#   #                          # platter branches.  Family representatives and
#   #                          # measurement prefer models resolved here;
#   #                          # unset = no tier preference.
#   # host RAM budget for `device: cpu` models (docs/plans/cpu-residency-budget.md):
#   host_pool: auto            # auto (min formula) | <abs> | <frac>%
#   # system_ram: 64G          # total override; default /proc/meminfo MemTotal
#   # host_pressure: sysctl    # arm: sysctl (zone high-wms floored by
#   #                          # vm.min_free_kbytes) | 25% | <abs>
#   # cgroup_dir: /sys/fs/cgroup/system.slice/llama-swap.service

# ── Roles are defined above ────────────────────────────
# Every role is declared in `roles:` with its trees (`dir`), placement
# (`device`) and allocation policy. Sidecars may set `role:` to override the
# tree's role. Placement lives on the role:
#   embeddings: {dir: embed, device: cpu, ...}

# ── Override rules (optional) ────────────────────────────
# Pattern-scoped serving choices. `when` is required; `when: true` matches all.
# `when` is map of frontmatter field → regex (re.search); list fields joined with spaces.
# Later matching rules win per-key; dir models.yaml overrides win over global.
# One merge rule everywhere: dicts merge per key, lists union-append
# (`-item` removes an inherited entry), None deletes a key outright.
# A rule declares only its delta — no restating full lists per model.
# overrides:
#   - when: {base_model: 'qwen3'}
#     chat_template: qwen_chat_template.jinja
#     reasoning-format: deepseek
#   # Any file key also takes {hf_repo:, file:[, pick:]} to track a hub file
#   # across `hf download` updates (no pinned copy); {file:} ≡ bare string.
#   # pick tokens: newest | oldest (snapshot revision), top (snapshot root
#   # only — skips subdirectory copies like a template repo's archive/).
#   - when: {base_model: 'qwen3'}
#     chat_template: {hf_repo: peculiar-ragdoll/Qwen-Sharp-Chat-Templates,
#                     file: chat_template.jinja, pick: top}
#   - when: {stem: 'Qwen3-32B.*safetensors'}
#     backend: vllm-docker
#     hf_repo: Qwen/Qwen3-32B
#   - when: {base_model: 'qwen3'}
#     loras: [shared-uncensored.gguf]   # appended to each model's loras
#   - when: {name: 'tiny-.*'}
#     cache_type: None                  # delete: fall back to built-in q8_0

# ── Context and routing knobs (optional) ───────────────
# A task's `min_context` is a floor and `max_context` is a ceiling. The old
# `embed_context` / `rerank_context` knobs are gone: put `max_context: 4096`
# on the embeddings/rerank tasks instead.
#
# Limits and guards for shared context:
#   tools_min_ctx     below this chat context, helpers are squeezed to buy
#                     context back (default 128k)
#   coload_min_ctx    how far helpers may be squeezed (default 20k)
#   ctx_gain_min      the minimum chat gain that makes the squeeze worth it
#   min_chat_ctx      the floor kept for a co-load (default 64k)
#   estimate_headroom pads an estimated, not measured, overhead (1.25)
#
# `sets:` switches the emitted config to matrix mode. Each set is its own
# memory budget: [A&B] [A&C] [A&D] constrains only the pairs, so all four can
# take half the pool, where capacity would force each to a quarter. Only a set
# can forbid a combination that fits. Expressions use llama-swap syntax:
# & (together), | (alternative), +set, +auto:orphans. A model in no set runs
# alone. Matrix never preloads: it evicts to the cheapest set containing the
# requested model and starts only that model.
#
# matrix:
#   tools_min_ctx: 131072
#   coload_min_ctx: 20480
#   ctx_gain_min: 4096
#   min_chat_ctx: 65536
#   estimate_headroom: 1.25
#   auto_parallel: false        # on by default: the packer chooses context and slots
#   auto_parallel_max: 8        # hard cap on auto slots (vLLM: 16)
#   parallel_power: 0.75        # slot exponent; a task's own overrides it
#   sets:                       # presence switches to matrix mode
#     rag: "chat & embeddings & rerank"
#     voice: "chat & t2s"
#
# ── Capacity routing knobs (optional) ──────────────────
# The generated config uses capacity routing:
#   reserve       = 1024 + max(1024, baseline_mb)
#   pools.default = detected VRAM - reserve - spare
#   pools.ram     = detected host pool
#   pools.<role>  = 1 (one live serving per role)
# Allocations fill pools.default on purpose; reserve + spare is every bit of
# headroom, so a nearly full pool is normal.
# Each model also gets an eviction cost: reload time plus lost prefill (chat
# only). `pp_tps`/`drive_mbps` are its inputs, not sizing knobs. A sidecar
# `pp_tps:` overrides the fleet value; estimate it from hardware TOPS x
# active parameters, or measure it with extras/bench.py / llama-bench.
# capacity:
#   pp_tps: 1000
#   # drive_mbps: 1000

# ── VRAM and RAM pools (optional) ───────────────────────────
# The emitted `default` pool is detected VRAM - reserve - spare. `pools:`
# sizes the solve around that pool; it does not change the emitted default
# pool. `ram.spare` is the exception: it keeps that much host RAM out of the
# emitted ram pool.
# pools:
#   default:
#     spare: 2G                  # per-pool solve spare (not the emitted pool)
#     reserve_extra: 8G          # VM, game, other tenant: chat is sized around it
#     pins:
#       image: 40G
#       embeddings: auto
#   ram:
#     spare: 2G                  # keep 2G of host RAM free

# ── Flag macros (optional) ──────────────────────────────────
# Named flag chunks for cmd readability (llama-swap macros). Auto-derived
# macros are always on: PROFILE_DEFAULTS (from defaults), PROFILE_<NAME> per
# profile cache/parallel, MODELS_<DIR> per models.yaml chat_template/loras.
# Explicit entries here have highest
# priority and are longest-first at replacement time; collision with an
# auto macro logs a warning and the new value wins.
# Use ${NAME} in cmd via the macro, and define values as plain shell strings.
# Example:
# macros:
#   COMMON: "--parallel 1 --cache-type-k q8_0 --cache-type-v q8_0 --n-gpu-layers 999"
#   QWEN: "--jinja --chat-template-file ${MODELS_DIR}/chat/qwen3/chat_template.jinja --reasoning-format deepseek"
