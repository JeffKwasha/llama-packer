# ── Sidecar syntax (NEW — lands in P2/P4) ───────────────
# Compatibility and capability are declared, never inferred. In a model
# sidecar (the `<model>.md` beside the weights):
#   engines: [llama-server]    # engine names that can load the weights;
#                              # required — a single-engine claim is a list
#   tasks: [embeddings]        # closed catalog ids; unset/empty = unverified
#                              # (never an invented name)
# `backend:` (compatibility) and `usage:` (workload tags) are the old
# spellings: they warn as alien keys once their portion lands, and there is
# no tolerated dual vocabulary.
#
# ── Global defaults ────────────────────────────────────
defaults:
  cache_type: q8_0
  parallel: 1
  temperature: 1.0
  top_p: 0.95
  top_k: 20
  min_p: 0.01
  pres_pen: 0.0

# ── Tasks (optional) ──────────────────────────────────
# A task is a closed catalog id (llama_packer/tasks.py): what work a model
# does, the endpoint it is served at, and the demand that work needs. A
# sidecar claims its tasks with `tasks: [coding, chat]`; each satisfiable
# task emits its own entry, and llama-swap routes by name. Only catalog ids
# exist -- an unknown id warns and is ignored.
#
# This section overrides a task's default demand; it never invents a task.
# min_context / min_parallel are floors, not requests: one entry at
# ctx >= 128k and parallel >= 2 satisfies all four tasks below, so nothing
# forces four entries per model.
#
# require:   capabilities that survive every rung of the capability/context
#            ladder. A model that cannot keep one is dropped from a set
#            rather than degraded.
# sacrifice: what to give up first when the budget is short. This is a
#            *preference*, not a cost order — shedding can buy no context at
#            all (a model already at its design cap has nothing to reclaim),
#            so the ladder enumerates rungs rather than walking them.
#            Unlisted capabilities follow the default order: vision before
#            draft, because an MTP draft roughly doubles generation speed.
#            Shedding a draft is opt-in per model (`allow_mtp_shed:`).
#
# Tasks are applied per set: a model that meets `coding` beside the
# canonical RAG pair but not beside a heavier reranker joins `rag` and is
# dropped from `ragz`. Only chat-task models are considered.
#
# shed: the default order for capabilities a task does not name.
# shed: [vision, draft]
tasks:
  coding:
    min_context: 128k
    min_parallel: 1
    sacrifice: [vision]
    keep: [draft]
  chat:
    min_context: 64k
    min_parallel: 2
    sacrifice: [draft, vision]
  qa:
    # QA means question answering. Whether a serving can also see is a
    # capability the model has or lacks, orthogonal to the kind of work --
    # so it is `capabilities: [image]` on the sidecar, not a `require` here.
    min_context: 32k
    min_parallel: 2
  aux:
    # One-off work: describe a picture, summarise a document. Not agentic, so
    # it does not need an agentic window, and a slot is worth more than
    # context -- the opposite trade from `coding`.
    min_context: 80k
    min_parallel: 2
    sacrifice: [draft]

# Model roots (CLI --models-dir overrides this). Role is selected by the
# first-level subdirectory: chat/ t2t/ vision/ doc/ → chat, embed/ →
# embeddings, rerank/ → rerank; other subdirs (img/, misc/, tmp/…) are
# ignored, and files at a root are chat.  Any subdirectory may also carry a
# models.yaml with subtree-scoped `defaults:` and `overrides:`.
models_dirs:
  - models
  # - /mnt/ai/models  # multiple roots allowed

# Extra directory roles (extend the built-ins). Keys matched case-insensitively;
# values must be chat | embeddings | rerank | image | s2t | t2s. CLI
# --extra-dirs adds directories to scan; they are chat unless named here.
# Image models are opt-in: add `img: image` here to serve diffusion weights via sd-server.
# Speech-to-text (whisper.cpp) is opt-in: add `s2t: s2t` to serve .bin weights
# via whisper-server (requires an authored same-stem sidecar per model).
# dirs:
#   it2t: chat
#   img: image
#   s2t: s2t

# HF cache root for hub-snapshot resolution (hf_repo + model sidecars) and
# the ${HF_HOME} path macro.  Defaults to $HF_HOME / $HUGGINGFACE_HUB_CACHE /
# ~/.cache/huggingface.
# hf_home: /mnt/data/huggingface

# Backend enable/prefer list — ordered; a backend absent from the list is
# disabled even when its resources are configured.  Omit the key to use all
# registered backends in default order (llama-server, vllm, vllm-podman,
# vllm-docker, sd-server, whisper-server, audio-cpp).  sd-server is opt-in
# for image generation, whisper-server/audio-cpp for speech; see the sd:/
# whisper:/audio_cpp: sections below.
# backends:
#   - llama-server
#   - vllm-docker
#   - sd-server
#   - whisper-server

# ── Profile definitions ────────────────────────────────
# Each profile overlays `defaults` and emits llama-swap setParamsByID
# overrides. `allow_profiles` in a model sidecar can filter which profiles
# apply to that model. Sidecar `modes:` layer over the same-named profile
# (single merge rule: dicts merge, lists append, None deletes) and replace
# the profile sampling overrides per-model when present.
profiles:
  default:

  coder:
    description: "coding and agentic work"
    temperature: "base * 0.7"

  # creative:
  #   description: "creative writing"
  #   temperature: "base * 1.2"

  # ── Sampling params ──────────────────────────────────
  # Keys: temperature, top_p, top_k, min_p, pres_pen, repeat_penalty,
  # freq_pen. Any key also present in `defaults` may use a "base * N"
  # expression (e.g. "base * 0.6"); otherwise set a literal. Values differing
  # from defaults are emitted as setParamsByID (request keys: pres_pen →
  # presence_penalty, freq_pen → frequency_penalty).
  # precise:
  #   description: "Low variance for extraction / QA"
  #   temperature: "base * 0.3"
  #   top_p: 0.9
  #   top_k: 10
  #   repeat_penalty: 1.1

  # story:
  #   description: "More diverse sampling for storytelling"
  #   temperature: "base * 1.3"
  #   min_p: 0.02
  #   pres_pen: 0.4
  #   freq_pen: 0.2

  # ── Grouping / placement params ──────────────────────
  # Distinct (parallel, cache_type, spare, batch, ubatch) combos get their
  # own VRAM solve and llama-swap entry; profile names within a group become
  # setParamsByID keys. `spare` reserves VRAM headroom (e.g. "512m", "6G").
  # `parallel` is the slot count — and a pin: declaring it opts the model
  # out of auto-parallel.
  # server:
  #   description: "Concurrency-tuned"
  #   parallel: 2
  #   cache_type: q4_K_M
  #   spare: 2G

  # low-mem:
  #   description: "Smaller KV cache for tight VRAM budgets"
  #   cache_type: q4_0
  #   spare: 1G

# ── llama-server backend args (optional) ────────────────
# Free-form flags appended to every llama-server command — fleet-wide
# performance/tuning knobs (per-model sidecar `cli_args:` still wins per
# flag).  Rendered BEFORE the named batch/ubatch flags, so those win over
# conflicting values here: `-b 512` in args tunes nothing once named keys
# are set (a warning points at the keys).  Non-conflicting flags (e.g.
# --flash-attn) apply to all roles and ARE part of the VRAM measurement
# shape — changing them re-measures every persisted `derived:` block.
#
# batch/ubatch are first-class planning keys with a resolution cascade:
#   sidecar batch:/ubatch:  >  profile key  >  llama_server: here  >  backend
#   role defaults
# Leaving a key unset anywhere in that cascade means **no flag is rendered**
# and llama.cpp's own builtin applies (-b 2048, -ub 512) — so an upstream
# default change is picked up for free instead of being pinned here. No
# llama-server role declares a batch default today: the old embed/rerank
# 4096 was never in effect (llama-server forces n_batch = n_ubatch when
# embeddings are enabled), so it was removed rather than copied. A malformed
# value is warned about and falls through to the next tier.
# `ubatch` shapes the compute buffer (~6 MiB per -ub token on Vulkan, no
# throughput cost measured) and stamps the VRAM measurement shape; `batch`
# has no VRAM effect and is deliberately not part of the shape.
# llama_server:
#   args: "--flash-attn on"
#   # batch: 2048       # -b, logical batch — throughput only, no VRAM effect
#   # ubatch: 512       # -ub, per-pass tokens — shapes the compute buffer

# ── vLLM backend (optional) ────────────────────────────
# Defaults for `backend: vllm` / `vllm-podman` / `vllm-docker` via overrides.
# CLI --vllm-image / --vllm-server win over this.
# vllm:
#   image: vllm/vllm-openai:latest
#   bin: vllm
#   docker_args: "--runtime=nvidia --gpus all --shm-size=16g"
#   container_port: 8000
#   # gpu_mem_util: 0.9  # derived from spare/reserve when omitted
#   # Fleet-wide serve flags (vLLM spellings — e.g. -ub 512 ≈
#   # --max-num-batched-tokens 512); per-model cli_args wins per flag.
#   # args: "--max-num-batched-tokens 512"

# ── sd-server backend (optional, image generation) ───────
# Defaults for `backend: sd-server` (stable-diffusion.cpp).  CLI --sd-server
# wins over this, then $SD_BIN_DIR, then the run directory (cwd),
# then `sd-server` on PATH.
# Unlike chat models, image models are fixed VRAM (weights + 512 MiB
# overhead) and excluded from the shared chat matrix — a 40 GB flux model won't
# collapse the chat budget.
# sd:
#   bin: sd-server
#   # Fleet-wide sd-server flags (--diffusion-fa etc.); per-model cli_args wins.
#   # args: "--diffusion-fa"

# ── whisper-server backend (optional, speech-to-text) ─────
# Defaults for `backend: whisper-server` (whisper.cpp examples/server).
# CLI --whisper-server wins over this, then $WHISPER_BIN_DIR, then the
# run directory (cwd), then `whisper-server` on PATH.  Opt-in: add `s2t: s2t` under `dirs:` above;
# each model needs an authored same-stem sidecar next to its GGML .bin
# (e.g. ggml-large-v3.md beside ggml-large-v3.bin).  Fixed VRAM overhead,
# excluded from the shared chat matrix.
# whisper:
#   bin: whisper-server
#   # Fleet-wide whisper-server flags (whisper.cpp shares --flash-attn);
#   # per-model cli_args wins.
#   # args: "--flash-attn on"

# ── audio-cpp backend (optional, TTS + ASR + music) ───────
# Defaults for `backend: audio-cpp` (native ggml audiocpp_server, 0xShug0).
# CLI --audio-cpp-server/--audio-cpp-backend win over this, then
# $AUDIOCPP_BIN_DIR, then the run directory (cwd), then
# `audiocpp_server` on PATH.  Opt-in: add
# `t2s: t2s` and/or `s2t: s2t` under `dirs:` above.  Fixed VRAM overhead
# (file size + family buffer), excluded from the shared chat matrix.
# One entry per sidecar (1:1) — switching models reloads audio.cpp.
# audio_cpp:
#   bin: /mnt/pool/data/tools/audiocpp/audiocpp_server
#   # Backend layering: sidecar audio_cpp.backend > --audio-cpp-backend >
#   # this value > vendor auto (NVIDIA→cuda, AMD→vulkan, else cpu).
#   backend: vulkan
#   device: 0
#   threads: 4
#   # Optional: per-entry TMPDIR env (shields /tmp/audiocpp-gguf extraction
#   # cache from other-uid ownership wedges on shared boxes).
#   # tmpdir: /tmp/audiocpp-llama-swap
#   # Stamped into every emitted server.json (see docs/backends/audio-cpp.md):
#   # max_loaded_models: 1
#   # idle_unload_ms: 60000
#   # busy_timeout_ms: 300000
#   # min_free_memory_mb: 2048
#   # voice_dir: /mnt/pool/data/tools/audiocpp/voices   # absolutized on emit
#   # model_spec_override: /mnt/pool/data/tools/audiocpp/model_specs

# ── Hardware (optional) ─────────────────────────────────
# Override the auto-detected VRAM pool and host-RAM budget. CLI --vram /
# --baseline / --unified-system-mb win over the VRAM side.
# hardware:
#   vram: 48G
#   # baseline_mb: 512m        # extra reserve on top of fixed 2 GiB (default 0)
#   # unified_system_mb: 8192  # system slice on unified hosts (default 8192)
#   # memory_margin: 0.04      # fraction inflated against every measured VRAM
#   #                          # term when solving (default 0.04: covers the
#   #                          # allocator overhead llama.cpp's own buffers
#   #                          # don't report, ~4% observed on Vulkan/radv)
#   # fast_storage: /mnt/@/ssd_ai   # physical branch (or list) that holds
#   #                          # SSD-resident models — reads ~6x faster than
#   #                          # platter branches.  Family representatives and
#   #                          # measurement prefer models resolved here;
#   #                          # unset = no tier preference.
#   # host RAM budget for `device: cpu` models (docs/plans/cpu-residency-budget.md):
#   host_pool: auto            # auto (min formula) | <abs> | <frac>%
#   # system_ram: 64G          # total override; default /proc/meminfo MemTotal
#   # host_pressure: sysctl    # arm: sysctl (zone high-wms floored by
#   #                          # vm.min_free_kbytes) | 25% | <abs>
#   # cgroup_dir: /sys/fs/cgroup/system.slice/llama-swap.service

# ── Role-wide host placement (optional) ─────────────────
# Every model of a named role runs from RAM — identical to tagging each
# sidecar `device: cpu`: no VRAM charge, same host budget, -ngl 0, never
# evicted by a swap, ttl 0. Only the four resident roles can be named here
# (embeddings, rerank, s2t, t2s); a chat model is placed per sidecar.
# The key is a role, the value is a device — there is no `role: cpu`.
# Unset = per-sidecar tags only.
# device_roles: [embeddings, rerank]
# device_roles: {embeddings: cpu, s2t: cpu}

# ── Override rules (optional) ────────────────────────────
# Pattern-scoped serving choices. `when` is required; `when: true` matches all.
# `when` is map of frontmatter field → regex (re.search); list fields joined with spaces.
# Later matching rules win per-key; dir models.yaml overrides win over global.
# One merge rule everywhere: dicts merge per key, lists union-append
# (`-item` removes an inherited entry), None deletes a key outright.
# A rule declares only its delta — no restating full lists per model.
# overrides:
#   - when: {base_model: 'qwen3'}
#     chat_template: qwen_chat_template.jinja
#     reasoning-format: deepseek
#   # Any file key also takes {hf_repo:, file:[, pick:]} to track a hub file
#   # across `hf download` updates (no pinned copy); {file:} ≡ bare string.
#   # pick tokens: newest | oldest (snapshot revision), top (snapshot root
#   # only — skips subdirectory copies like a template repo's archive/).
#   - when: {base_model: 'qwen3'}
#     chat_template: {hf_repo: peculiar-ragdoll/Qwen-Sharp-Chat-Templates,
#                     file: chat_template.jinja, pick: top}
#   - when: {stem: 'Qwen3-32B.*safetensors'}
#     backend: vllm-docker
#     hf_repo: Qwen/Qwen3-32B
#   - when: {base_model: 'qwen3'}
#     loras: [shared-uncensored.gguf]   # appended to each model's loras
#   - when: {name: 'tiny-.*'}
#     cache_type: None                  # delete: fall back to built-in q8_0

# ── Roles (optional; NEW — lands in P5) ─────────────────
# A role is a use case that *hosts* tasks; it does not require them — RAG
# with the rerank slot empty is thinner but valid. `pinned` tasks are
# resident, `on_demand` (the default) load when requested and evict their
# siblings. Role terms reach every element's serving and degrade before the
# task's own terms do. The matrix `sets:` below are generated from this
# table, so hand-authored sets become alien when this lands.
# roles:
#   chat:
#     tasks:
#       - chat: pinned
#       - agent: on_demand
#   rag:
#     min_context: 4k
#     sacrifice: [concurrency, vision]
#     tasks:
#       - embed: pinned
#       - rerank: pinned
#   voice:
#     tasks:
#       - stt: pinned
#       - tts: pinned
#
# ── Matrix: shared VRAM and routing sets (optional) ────
# Residents are pinned and served at a fixed small context, so their
# footprint is a number you can compute up front; whatever is left goes to
# chat, and each chat model resolves its own serving against it through its
# usage category (see `usage:` above and SPEC.md "VRAM Allocation").
#
# `embed_context` / `rerank_context` are that fixed context. They are small
# on purpose: clients chunk to one stable RAG size, and a flexing context
# would make the resident tier's VRAM move under the budget. If VRAM is the
# binding constraint, context in main chat is worth more than context in RAG.
# Select the residents with --embed / --rerank or a category `selector:`;
# they always serve single-slot.
#
# The shared solve's floors and guards, in the order it applies them:
#   tools_min_ctx     below this chat context, the RAG pair is squeezed to
#                     buy context back (default 128k)
#   coload_min_ctx    how far the RAG pair may be squeezed (default 20k)
#   ctx_gain_min      the minimum chat gain that makes the squeeze worth it
#                     (default 4k)
#   min_chat_ctx      the floor kept for a co-load; below it nothing else is
#                     admitted (default 64k; tools_min_ctx when tools still
#                     have it)
#   estimate_headroom pads an estimated, not measured, co-load overhead
#                     (default 1.25; must be >= 1.0)
#
# A routing set is a use case — a composition of roles that must be live
# together. `rag` is embed AND rerank (two roles); `talk` is stt AND tts.
# One set names one model per role; a second category of the same role is an
# alternative (`rnk | rnk2`), never an addition. Operators may declare their
# own buckets (one/two/three) and compose them without naming a task.
# The sets are also the VRAM budget contract: the chat solve reserves the
# worst branch of the most expensive chat set (`&` sums, `|` maxes, `+set`
# expands a named set), not the sum of every declared category. A category
# no chat set references reserves nothing (it can only run alone).
#
# matrix:
#   embed_context: 4096
#   rerank_context: 4096
#   # tools_min_ctx: 131072
#   # coload_min_ctx: 20480
#   # ctx_gain_min: 4096
#   # min_chat_ctx: 65536
#   # estimate_headroom: 1.25
#   auto_parallel: false        # on by default: value-function (ctx, slots)
#                               # solve for unpinned chat; false disables it
#                               # fleet-wide
#   auto_parallel_max: 8        # hard cap on auto slots (vLLM: 16)
#   parallel_power: 0.75        # slot exponent: how much context one extra
#                               # slot may cost. See SPEC.md
#   categories:                 # var -> served model; `emb`/`rnk` are the
#     emb: { role: embeddings } # canonical names of the RAG roles
#     rnk: { role: rerank }
#     rnk2: { role: rerank, selector: zerank }   # alternative, not additive
#     stt: { role: s2t }
#     tts: { role: t2s }
#   sets:
#     rag:   "__CHAT_VARS__ & emb & rnk"
#     ragz:  "__CHAT_VARS__ & emb & rnk2"
#     talk:  "__CHAT_VARS__ & stt & tts"           # 2-way speech
#     combo: "__CHAT_VARS__ & (three | (two & one))"  # operator buckets
#   # evict_costs: {one: 10, two: 10, three: 10}  # forwarded to llama-swap

# ── VRAM pools (optional) ───────────────────────────────────
# One shared ledger per pool: per-pool spare override, unmodelled residents,
# and explicit claimant reservations. "auto" keeps the derived math.
# pools:
#   default:
#     spare: 2G
#     reserve_extra: 8G          # VM, game, other tenant
#     pins:
#       image: 40G
#       embeddings: auto

# ── Flag macros (optional) ──────────────────────────────────
# Named flag chunks for cmd readability (llama-swap macros). Auto-derived
# macros are always on: PROFILE_DEFAULTS (from defaults), PROFILE_<NAME> per
# profile cache/parallel, MODELS_<DIR> per models.yaml chat_template/loras.
# Explicit entries here have highest
# priority and are longest-first at replacement time; collision with an
# auto macro logs a warning and the new value wins.
# Use ${NAME} in cmd via the macro, and define values as plain shell strings.
# Example:
# macros:
#   COMMON: "--parallel 1 --cache-type-k q8_0 --cache-type-v q8_0 --n-gpu-layers 999"
#   QWEN: "--jinja --chat-template-file ${MODELS_DIR}/chat/qwen3/chat_template.jinja --reasoning-format deepseek"
